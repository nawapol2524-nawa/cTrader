# ================================================================
# cTrader Open API Credentials (ตามชื่อตัวแปรเป๊ะๆ)
# สมัครและสร้าง Application ได้ที่ https://openapi.ctrader.com/apps
# ================================================================

ClientID=your_client_id_here
ClientSecret=your_client_secret_here
AccessToken=your_access_token_here
AccountID=12345678

# cTrader Open API WebSocket Endpoint (Demo)
CTRADER_WS_URL=wss://demo.ctraderapi.com:5036

# Server Port (Render จะกำหนด PORT ให้อัตโนมัติ)
PORT=10000
