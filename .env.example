# ================================================================
# cTrader Open API Credentials (Deriv Demo / Live)
# สมัครและสร้าง Application ได้ที่ https://openapi.ctrader.com/apps
# ================================================================

# Client Credentials จาก cTrader Open API Application
CTRADER_CLIENT_ID=your_client_id_here
CTRADER_CLIENT_SECRET=your_client_secret_here

# cTrader Account ID (cTID Trader Account ID ตัวเลข เช่น 12345678)
CTRADER_ACCOUNT_ID=12345678

# Access Token ที่ได้จากการ Authenticate บัญชี (ต้องมีสิทธิ์ 'trade')
CTRADER_ACCESS_TOKEN=your_access_token_here

# Environment: demo หรือ live (ค่าเริ่มต้นคือ demo สำหรับ Deriv Demo)
CTRADER_ENVIRONMENT=demo

# Host & Port สำหรับ FastAPI Webhook Server
HOST=0.0.0.0
PORT=8000
